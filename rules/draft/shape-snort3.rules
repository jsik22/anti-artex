# anti-artex draft request-shape rules (Snort 3). 근거: 실측 헤더 모양(docs/lab-mock-2026-11-21.md). 브라우저 UA + 도구 기본 헤더 모양 불일치.
alert http (msg:"LOCAL ARTEX HUNT browser UA with Go default header shape (WebFetch-like, UA changed)"; flow:to_server,established; http_raw_header; content:"User-Agent: Mozilla/5.0",fast_pattern; pcre:"/^Host: [^\r\n]*\r\nUser-Agent: Mozilla\/5\.0[^\r\n]*\r\nAccept-Encoding: gzip(?:\r\n)*$/"; classtype:policy-violation; sid:9278394; rev:1;)
alert http (msg:"LOCAL ARTEX HUNT browser UA with Python urllib header shape (api-recon-like, UA changed)"; flow:to_server,established; http_raw_header; content:"User-Agent: Mozilla/5.0",fast_pattern; content:!"spa-api-recon"; pcre:"/^Accept-Encoding: identity\r\nHost: [^\r\n]*\r\nUser-Agent: Mozilla\/5\.0[^\r\n]*\r\nConnection: close(?:\r\n)*$/"; classtype:policy-violation; sid:9278395; rev:1;)
