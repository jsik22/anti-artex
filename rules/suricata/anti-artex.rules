# anti-artex v0.2.0 (Suricata 7)
# ARTEX(자율 AI 침투 도구) 기본 설정 트래픽 지문. 근거는 docs/fingerprints.md(소스 정적 분석).
# 자체 제작·자체 시험이며 계속 업데이트 중이다. 실측 전이니 차단 대신 탐지(alert) 모드로 먼저 돌린다. POLICY·HUNT 룰은 사냥·정책용이다.
alert http any any -> any any (msg:"LOCAL ARTEX enrich prober User-Agent (artex-enrich)"; flow:to_server,established; http.user_agent; content:"artex-enrich/"; startswith; fast_pattern; classtype:attempted-recon; sid:9278301; rev:1;)
alert http any any -> any any (msg:"LOCAL ARTEX worker WebFetch User-Agent (norma)"; flow:to_server,established; http.user_agent; content:"norma/"; startswith; fast_pattern; classtype:attempted-recon; sid:9278302; rev:1;)
alert http any any -> any any (msg:"LOCAL ARTEX api-recon skill User-Agent (spa-api-recon)"; flow:to_server,established; http.user_agent; content:"Mozilla/5.0 (spa-api-recon"; startswith; fast_pattern; classtype:attempted-recon; sid:9278303; rev:1;)
alert http any any -> any any (msg:"LOCAL ARTEX POLICY console self-update egress (artex-selfupdate)"; flow:to_server,established; http.user_agent; content:"artex-selfupdate"; startswith; fast_pattern; classtype:policy-violation; sid:9278304; rev:1;)
alert http any any -> any any (msg:"LOCAL ARTEX backdoored console login command (captcha bang prefix)"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/api/auth/login"; fast_pattern; http.request_body; content:"captcha"; pcre:"/\x22captcha\x22\s*:\s*\x22!/"; classtype:attempted-admin; sid:9278305; rev:1;)
alert http any any -> any any (msg:"LOCAL ARTEX fork enrich prober User-Agent (artifex/antifox/wsartex/prtseek)"; flow:to_server,established; http.user_agent; content:"-enrich/"; fast_pattern; pcre:"/^(?:artifex|antifox|wsartex|prtseek)-enrich\//"; classtype:attempted-recon; sid:9278306; rev:1;)
alert http any any -> any any (msg:"LOCAL ARTEX POLICY fork console self-update egress"; flow:to_server,established; http.user_agent; content:"update"; fast_pattern; pcre:"/^(?:(?:artifex|antifox|prtseek|scopeweaver|pojun)-selfupdate|artex-update-check)/"; classtype:policy-violation; sid:9278308; rev:1;)
alert http any any -> any any (msg:"LOCAL ARTEX fork tool User-Agent (ARTEX token)"; flow:to_server,established; http.user_agent; content:"ARTEX"; fast_pattern; pcre:"/(?:\(ARTEX\)|\bARTEX-[A-Z][A-Za-z-]+\/)/"; classtype:attempted-recon; sid:9278307; rev:1;)
alert http any any -> any any (msg:"LOCAL ARTEX fork recon User-Agent (YCode-recon)"; flow:to_server,established; http.user_agent; content:"YCode-recon/"; fast_pattern; classtype:attempted-recon; sid:9278309; rev:1;)
alert http any any -> any any (msg:"LOCAL ARTEX fork HTTP observation User-Agent (prtseek)"; flow:to_server,established; http.user_agent; content:"prtseek/"; fast_pattern; pcre:"/^prtseek\/[0-9.]+ HTTP observation/"; classtype:attempted-recon; sid:9278310; rev:1;)
alert http any any -> any any (msg:"LOCAL ARTEX fork CT subdomain User-Agent (Artifex-ct-subs)"; flow:to_server,established; http.user_agent; content:"Artifex-ct-subs"; fast_pattern; classtype:attempted-recon; sid:9278311; rev:1;)
