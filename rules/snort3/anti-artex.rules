# anti-artex v0.4.1 (Snort 3)
# ARTEX(자율 AI 침투 도구) 기본 설정 트래픽 지문. 근거는 docs/fingerprints.md(소스 정적 분석).
# 자체 제작·자체 시험이며 계속 업데이트 중이다. 실측 전이니 차단 대신 탐지(alert) 모드로 먼저 돌린다. POLICY·HUNT 룰은 사냥·정책용이다.
alert http any any -> any any ( msg:"LOCAL ARTEX enrich prober User-Agent (artex-enrich)"; flow:to_server,established; http_header:field user-agent; content:"artex-enrich/",depth 13,fast_pattern; classtype:attempted-recon; sid:9278301; rev:1; )
alert http any any -> any any ( msg:"LOCAL ARTEX worker WebFetch User-Agent (norma)"; flow:to_server,established; http_header:field user-agent; content:"norma/",depth 6,fast_pattern; classtype:attempted-recon; sid:9278302; rev:1; )
alert http any any -> any any ( msg:"LOCAL ARTEX api-recon skill User-Agent (spa-api-recon)"; flow:to_server,established; http_header:field user-agent; content:"Mozilla/5.0 (spa-api-recon",depth 26,fast_pattern; classtype:attempted-recon; sid:9278303; rev:1; )
alert http any any -> any any ( msg:"LOCAL ARTEX POLICY console self-update egress (artex-selfupdate)"; flow:to_server,established; http_header:field user-agent; content:"artex-selfupdate",depth 16,fast_pattern; classtype:policy-violation; sid:9278304; rev:1; )
alert http any any -> any any ( msg:"LOCAL ARTEX backdoored console login command (captcha bang prefix)"; flow:to_server,established; http_method; content:"POST"; http_uri; content:"/api/auth/login",fast_pattern; http_client_body; content:"captcha"; pcre:"/\x22captcha\x22\s*:\s*\x22!/"; classtype:attempted-admin; sid:9278305; rev:1; )
alert http any any -> any any ( msg:"LOCAL ARTEX fork enrich prober User-Agent (artifex/antifox/wsartex/prtseek)"; flow:to_server,established; http_header:field user-agent; content:"-enrich/",fast_pattern; pcre:"/^(?:artifex|antifox|wsartex|prtseek)-enrich\//"; classtype:attempted-recon; sid:9278306; rev:1; )
alert http any any -> any any ( msg:"LOCAL ARTEX POLICY fork console self-update egress"; flow:to_server,established; http_header:field user-agent; content:"update",fast_pattern; pcre:"/^(?:(?:artifex|antifox|prtseek|scopeweaver|pojun)-selfupdate|artex-update-check)/"; classtype:policy-violation; sid:9278308; rev:1; )
alert http any any -> any any ( msg:"LOCAL ARTEX fork tool User-Agent (ARTEX token)"; flow:to_server,established; http_header:field user-agent; content:"ARTEX",fast_pattern; pcre:"/(?:\(ARTEX\)|\bARTEX-[A-Z][A-Za-z-]+\/)/"; classtype:attempted-recon; sid:9278307; rev:1; )
alert http any any -> any any ( msg:"LOCAL ARTEX fork recon User-Agent (YCode-recon)"; flow:to_server,established; http_header:field user-agent; content:"YCode-recon/",fast_pattern; classtype:attempted-recon; sid:9278309; rev:1; )
alert http any any -> any any ( msg:"LOCAL ARTEX fork HTTP observation User-Agent (prtseek)"; flow:to_server,established; http_header:field user-agent; content:"prtseek/",fast_pattern; pcre:"/^prtseek\/[0-9.]+ HTTP observation/"; classtype:attempted-recon; sid:9278310; rev:1; )
alert http any any -> any any ( msg:"LOCAL ARTEX fork CT subdomain User-Agent (Artifex-ct-subs)"; flow:to_server,established; http_header:field user-agent; content:"Artifex-ct-subs",fast_pattern; classtype:attempted-recon; sid:9278311; rev:1; )

# v0.3.0: 실험실 실측(가짜 모델 구동) 근거 룰. docs/lab-mock-2026-11-21.md
# HUNT: 로그인 POST 연속(ARTEX 전용 아님, 자동화 공격 일반). 다른 신호와 함께 판단
alert http (msg:"LOCAL ARTEX HUNT login POST burst (credential variation)"; flow:to_server,established; http_method; content:"POST"; http_uri; pcre:"/(?:log_?in|sign_?in|auth)/i"; detection_filter:track by_src, count 6, seconds 30; classtype:attempted-user; sid:9278390; rev:1;)
# HUNT: 브라우저 UA인데 도구 기본 헤더 모양(UA만 바꾼 포크). 브라우저 위장 수집기도 걸린다
alert http (msg:"LOCAL ARTEX HUNT browser UA with Go default header shape (WebFetch-like, UA changed)"; flow:to_server,established; http_raw_header; content:"User-Agent: Mozilla/5.0",fast_pattern; pcre:"/^Host: [^\r\n]*\r\nUser-Agent: Mozilla\/5\.0[^\r\n]*\r\nAccept-Encoding: [^\r\n]*(?:\r\n)*$/"; classtype:policy-violation; sid:9278394; rev:2;)
alert http (msg:"LOCAL ARTEX HUNT browser UA with Python urllib header shape (api-recon-like, UA changed)"; flow:to_server,established; http_raw_header; content:"User-Agent: Mozilla/5.0",fast_pattern; content:!"spa-api-recon"; pcre:"/^Accept-Encoding: [^\r\n]*\r\nHost: [^\r\n]*\r\nUser-Agent: Mozilla\/5\.0[^\r\n]*\r\nConnection: [^\r\n]*(?:\r\n)*$/"; classtype:policy-violation; sid:9278395; rev:2;)
# v0.4.0(2026-11-22 실측, docs/lab-mock-2026-11-22.md): v0.7.0 WebFetch·기록 프록시를 거친 요청의 헤더 모양, 기록 프록시가 남기는 Proxy-Connection
alert http (msg:"LOCAL ARTEX HUNT browser UA with Go header shape plus Connection close (WebFetch v0.7-like or proxied tool, UA changed)"; flow:to_server,established; http_raw_header; content:"User-Agent: Mozilla/5.0",fast_pattern; content:!"spa-api-recon"; pcre:"/^Host: [^\r\n]*\r\nUser-Agent: Mozilla\/5\.0[^\r\n]*\r\nAccept-Encoding: [^\r\n]*\r\nConnection: close(?:\r\n)*$/"; classtype:policy-violation; sid:9278396; rev:1;)
alert http (msg:"LOCAL ARTEX HUNT Proxy-Connection header reached origin server (ARTEX capture proxy leak)"; flow:to_server,established; http_raw_header; content:"Proxy-Connection:",nocase; classtype:policy-violation; sid:9278397; rev:1;)
