# anti-artex v0.1.0 (Snort 3)
# ARTEX(자율 AI 침투 도구) 기본 설정 트래픽 지문. 근거는 docs/fingerprints.md(소스 정적 분석).
# 자체 제작·자체 시험이며 계속 업데이트 중이다. 실측 전이니 차단 대신 탐지(alert) 모드로 먼저 돌린다. POLICY·HUNT 룰은 사냥·정책용이다.
alert http any any -> any any ( msg:"LOCAL ARTEX enrich prober User-Agent (artex-enrich)"; flow:to_server,established; http_header:field user-agent; content:"artex-enrich/",depth 13,fast_pattern; classtype:attempted-recon; sid:9278301; rev:1; )
alert http any any -> any any ( msg:"LOCAL ARTEX worker WebFetch User-Agent (norma)"; flow:to_server,established; http_header:field user-agent; content:"norma/",depth 6,fast_pattern; classtype:attempted-recon; sid:9278302; rev:1; )
alert http any any -> any any ( msg:"LOCAL ARTEX api-recon skill User-Agent (spa-api-recon)"; flow:to_server,established; http_header:field user-agent; content:"Mozilla/5.0 (spa-api-recon",depth 26,fast_pattern; classtype:attempted-recon; sid:9278303; rev:1; )
alert http any any -> any any ( msg:"LOCAL ARTEX POLICY console self-update egress (artex-selfupdate)"; flow:to_server,established; http_header:field user-agent; content:"artex-selfupdate",depth 16,fast_pattern; classtype:policy-violation; sid:9278304; rev:1; )
alert http any any -> any any ( msg:"LOCAL ARTEX backdoored console login command (captcha bang prefix)"; flow:to_server,established; http_method; content:"POST"; http_uri; content:"/api/auth/login",fast_pattern; http_client_body; content:"captcha"; pcre:"/\x22captcha\x22\s*:\s*\x22!/"; classtype:attempted-admin; sid:9278305; rev:1; )
